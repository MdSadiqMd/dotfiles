[user]
    name = Md.Sadiq
	signingkey = 22825064A7120CF50581BBADBDFA0A451C77AD56
[commit]
	gpgsign = true
[tag]
    gpgSign = true

# Email and the per-directory work identity: sops secret git-private, so neither
# the address nor the company directory is published.
[include]
  path = ~/.gitconfig.private
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# GitHub over https uses gh's token (sops secret github-token), not the keychain.
# The empty helper drops the osxkeychain helper git ships with, for these hosts only.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
