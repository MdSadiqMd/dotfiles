// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Material Icon Theme",
  "theme": "Tokyo Night",
  "autosave": {
    "after_delay": {
      "milliseconds": 10,
    },
  },
  "languages": {
    "Go": {
      "formatter": {
        "external": {
          "command": "gofmt",
          "arguments": ["-s"],
        },
      },
      "format_on_save": "on",
    },
  },
  "format_on_save": "on",
  "theme_overrides": {
    "Tokyo Night": {
      "tab.active_background": "#24273736",
      "element.active": "#24273736",
      "ghost_element.selected": "#24273736",
      "element.selected": "#41486936",
      "element.hover": "#41486936",
      "ghost_element.hover": "#41486936",
    },
    "One Dark Pro": {
      "editor.background": "#282c34",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
      "accents": [
        "#e06c75",
        "#e5c07b",
        "#98c379",
        "#61afef",
        "#c678dd",
        "#56b6c2",
      ],
    },
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
}
