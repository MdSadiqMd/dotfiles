// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Material Icon Theme",
  "theme": "Tokyo Night",
  "autosave": {
    "after_delay": {
      "milliseconds": 10,
    },
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "..."],
      "format_on_save": "on",
      "tab_size": 2,
      "show_completions_on_input": true,
      "enable_language_server": true,
    },
    "TSX": {
      "language_servers": ["vtsls", "..."],
      "format_on_save": "on",
      "tab_size": 2,
      "show_completions_on_input": true,
      "enable_language_server": true,
    },
    "JavaScript": {
      "language_servers": ["vtsls", "..."],
      "format_on_save": "on",
      "tab_size": 2,
      "show_completions_on_input": true,
      "enable_language_server": true,
    },
    "Go": {
      "formatter": {
        "external": {
          "command": "gofmt",
          "arguments": ["-s"],
        },
      },
      "format_on_save": "on",
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "suggest": {
            "autoImports": true,
            "paths": true,
            "completeFunctionCalls": true,
          },
          "preferences": {
            "importModuleSpecifier": "relative",
            "includeInlayParameterNameHints": "all",
            "includeInlayFunctionParameterTypeHints": true,
            "includeInlayVariableTypeHints": true,
            "includeInlayPropertyDeclarationTypeHints": true,
            "includeInlayFunctionLikeReturnTypeHints": true,
            "includeInlayEnumMemberValueHints": true,
          },
          "tsserver": {
            "maxTsServerMemory": 8092,
          },
        },
        "javascript": {
          "suggest": {
            "autoImports": true,
            "paths": true,
            "completeFunctionCalls": true,
          },
          "preferences": {
            "importModuleSpecifier": "relative",
            "includeInlayParameterNameHints": "all",
            "includeInlayFunctionParameterTypeHints": true,
            "includeInlayVariableTypeHints": true,
            "includeInlayPropertyDeclarationTypeHints": true,
            "includeInlayFunctionLikeReturnTypeHints": true,
            "includeInlayEnumMemberValueHints": true,
          },
          "tsserver": {
            "maxTsServerMemory": 8092,
          },
        },
      },
    },
  },
  "format_on_save": "on",
  "show_completions_on_input": true,
  "theme_overrides": {
    "Tokyo Night": {
      "tab.active_background": "#24273736",
      "element.active": "#24273736",
      "ghost_element.selected": "#24273736",
      "element.selected": "#41486936",
      "element.hover": "#41486936",
      "ghost_element.hover": "#41486936",
    },
    "One Dark Pro": {
      "editor.background": "#282c34",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
      "accents": [
        "#e06c75",
        "#e5c07b",
        "#98c379",
        "#61afef",
        "#c678dd",
        "#56b6c2",
      ],
    },
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
}
