{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf *)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/**)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claudemon/statusline.sh\""
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "caveman@caveman": true,
    "claudemon@claudemon": true,
    "gopls-lsp@claude-plugins-official": true,
    "localstack@localstack-dev": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "sagemaker-ai@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claudemon": {
      "source": {
        "source": "github",
        "repo": "zamarrowski/claudemon"
      }
    },
    "localstack-dev": {
      "source": {
        "source": "github",
        "repo": "localstack/skills"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
