{
  "env": {
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf *)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/**)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.pre_tool_use",
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.session_start"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.subagent_start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.subagent_stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.session_end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.user_prompt_submit"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.permission_request",
            "timeout": 86400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.post_tool_use"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "WATCHER=WATCHER WATCHER_BACKEND_PORT=8228 WATCHER_FRONTEND_PORT=8228 WATCHER_API_URL=https://app.apolloresearch.ai/api /Users/sadiq/.local/share/apollo-watcher/watcher/watcher -m apollo_monitor.hooks.claude_code.statusline '\"$HOME/.claudemon/statusline.sh\"'"
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "caveman@caveman": true,
    "claudemon@claudemon": true,
    "gopls-lsp@claude-plugins-official": true,
    "localstack@localstack-dev": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "sagemaker-ai@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claudemon": {
      "source": {
        "source": "github",
        "repo": "zamarrowski/claudemon"
      }
    },
    "localstack-dev": {
      "source": {
        "source": "github",
        "repo": "localstack/skills"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
