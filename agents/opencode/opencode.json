{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "MotherDuck": {
        "type": "remote",
        "url": "https://api.motherduck.com/mcp",
        "headers": {
          "Authorization": "Bearer {file:~/.config/sops-nix/secrets/motherduck-token}"
        }
      }
    }
  },
  "providers": {
    "gateway": {
      "name": "gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{file:~/.config/sops-nix/secrets/llm-gateway-url}",
        "apiKey": "{file:~/.config/sops-nix/secrets/llm-gateway-api-key}"
      },
      "models": {
        "claude-sonnet-4.6": {
          "name": "Gateway claude-sonnet-4.6",
          "limit": { "context": 1000000, "output": 128000 },
          "cost": { "input": 3, "output": 15 }
        },
        "gpt-5.2-codex": {
          "name": "Gateway gpt-5.2-codex",
          "limit": { "context": 400000, "output": 128000 },
          "cost": { "input": 0.61, "output": 2.94 }
        },
        "gpt-5.1-codex": {
          "name": "Gateway gpt-5.1-codex",
          "limit": { "context": 400000, "output": 128000 },
          "cost": { "input": 0.61, "output": 2.94 }
        },
        "deepseek-v4.1-flash": {
          "name": "Gateway deepseek-v4.1-flash",
          "limit": { "context": 1048576, "output": 393216 },
          "cost": { "input": 0.3, "output": 1.2 }
        },
        "kimi-k2.7-code": {
          "name": "Gateway kimi-k2.7-code",
          "limit": { "context": 262144, "output": 262144 },
          "cost": { "input": 0.95, "output": 4 }
        },
        "glm-5.3": {
          "name": "Gateway glm-5.3",
          "limit": { "context": 1048576, "output": 131072 },
          "cost": { "input": 1.4, "output": 4.4 }
        }
      }
    }
  }
}
