{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen",
      "options": {
        "baseURL": "http://192.168.0.37:8082/v1"
      },
      "models": {
        "qwen3-27b": {
          "name": "Qwen3 27B Dognosis"
        }
      }
    }
  },
  "mcp": {
    "MotherDuck": {
      "type": "remote",
      "url": "https://api.motherduck.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:~/.config/sops-nix/secrets/motherduck-token}"
      }
    }
  }
}
